# Object files and archives
*.o
*.a
*.so

# Built binaries (the `pickle` source directory is un-ignored below so the
# bare `/pickle` pattern only catches a same-named root-level binary).
/pickle
/pickle-*
!/pickle/

# Build directories
build/

# Model files (do not commit GGUF weights — they are large and often licensed)
*.gguf
models/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Compile commands generated by build systems
compile_commands.json

# OS cruft
.DS_Store
Thumbs.db
