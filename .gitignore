# Object files and archives
*.o
*.a
*.so

# Built binaries at the repo root (the `pickle` source tree lives under
# `src/`, so these patterns only catch the executable artifacts).
/pickle
/pickle_*
/pickle-*

# Build directories
build/

# Model files (do not commit GGUF weights — they are large and often licensed)
*.gguf
models/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Compile commands generated by build systems
compile_commands.json

# OS cruft
.DS_Store
Thumbs.db
